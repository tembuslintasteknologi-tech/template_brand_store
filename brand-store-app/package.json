{
  "name": "brand-store-api",
  "version": "2.0.0",
  "description": "Headless Single-Brand Store Backend Template (Bun + Hono + Drizzle)",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "build": "node --import tsx/esm src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "node --test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.14",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
