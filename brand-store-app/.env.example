# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brand_store
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth / JWT (AUT-004: access 15 minutes, refresh 7 days)
# ---------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# First admin seed (CFG-013)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@brandstore.com
ADMIN_PASSWORD=Admin12345!

# ---------------------------------------------------------------------------
# BRAND / STORE DEFAULTS
# ---------------------------------------------------------------------------
STORE_NAME=Brand Store
CURRENCY=IDR
LOCALE=id-ID
TAX_PERCENT=11
PAYMENT_EXPIRY_MINUTES=60

# Default store origin used by shipping-rate and pickup calculations (CFG-011)
STORE_ORIGIN_NAME=Gudang Utama
STORE_ORIGIN_PHONE=0210000000
STORE_ORIGIN_ADDRESS=Jl. Contoh No. 1
STORE_ORIGIN_CITY=Jakarta
STORE_ORIGIN_PROVINCE=DKI Jakarta
STORE_ORIGIN_POSTAL_CODE=10000

# ---------------------------------------------------------------------------
# Tembus logistics (LOG-001)
# ---------------------------------------------------------------------------
TEMBUS_API_KEY=
TEMBUS_API_URL=https://api.tembus.test
TEMBUS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Midtrans payment gateway (PAY-001)
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Object storage S3 / MinIO (CAT-004)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=brand-store
MINIO_USE_SSL=false
