# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brand_store
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth / JWT (AUT-004: access 15 minutes, refresh 7 days)
# ---------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# First admin seed (CFG-013)
# Password di bawah adalah contoh publik. Ganti sebelum go live. Login akan menandai
# mustChangePassword selama hash masih cocok dengan contoh di repo.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@brandstore.com
ADMIN_PASSWORD=Admin12345!

# ---------------------------------------------------------------------------
# Security dan observability (SEC)
# ---------------------------------------------------------------------------
# Daftar IP atau CIDR yang boleh mengakses /api/v1/admin/*. Kosong berarti semua IP
# lolos, yang berarti proteksi belum aktif.
ADMIN_IP_ALLOWLIST=
# Token untuk GET /metrics. Wajib diisi di production. Buat dengan: openssl rand -hex 32
METRICS_TOKEN=
ALERT_ERROR_RATE=0.05
ALERT_P95_LATENCY_MS=1500
ALERT_MEMORY_USED_PERCENT=90
ALERT_MIN_SAMPLES=20
# Kunci 32 byte untuk enkripsi secret TOTP (64 hex atau base64). Wajib untuk enrollment 2FA.
TOTP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# BRAND / STORE DEFAULTS
# ---------------------------------------------------------------------------
STORE_NAME=Brand Store
CURRENCY=IDR
LOCALE=id-ID
TAX_PERCENT=11
PAYMENT_EXPIRY_MINUTES=60

# Default store origin used by shipping-rate and pickup calculations (CFG-011)
STORE_ORIGIN_NAME=Gudang Utama
STORE_ORIGIN_PHONE=0210000000
STORE_ORIGIN_ADDRESS=Jl. Contoh No. 1
STORE_ORIGIN_CITY=Jakarta
STORE_ORIGIN_PROVINCE=DKI Jakarta
STORE_ORIGIN_POSTAL_CODE=10000

# ---------------------------------------------------------------------------
# Tembus logistics (LOG-001)
# ---------------------------------------------------------------------------
TEMBUS_API_KEY=
TEMBUS_API_URL=https://api.tembus.test
TEMBUS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Midtrans payment gateway (PAY-001)
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Object storage S3 / MinIO (CAT-004)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=brand-store
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# OpenTelemetry tracing (OBS-001)
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=brand-store-api
OTEL_SERVICE_VERSION=2.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Header collector, format key=value,key2=value2
OTEL_EXPORTER_OTLP_HEADERS=
# Rasio sampling root span, 0 sampai 1
OTEL_TRACES_SAMPLER_ARG=1
